#!/usr/bin/env bash
#
# leo-spaces-admin — the whole privileged surface of the Spaces package.
#
# Installed root-owned at /usr/local/bin/leo-spaces-admin by
# scripts/install-admin-wrapper.sh, which also writes the one sudoers rule
# that permits it. The package calls nothing else with privilege.
#
# WHY A WRAPPER AND NOT SUDO. Hypervisor setup is root work: packages, units,
# /etc/modprobe.d, the kernel command line. A Leo hub's service account
# deliberately has no blanket sudo, and giving it one would make every bug in
# this package a root bug. So the grant names ONE program with a CLOSED VERB
# SET. Each verb below is a fixed sequence of commands; the only caller-
# supplied value anywhere is a PCI id pair, and it is matched against a
# regex before it reaches a file. There is no verb that takes a command.
#
# Re-running any verb is safe. They are written to converge, not to toggle,
# because the package derives what is missing on every page load and an
# operator will press the button twice.

set -euo pipefail

VERSION=1
STATE_DIR=/var/lib/leo-spaces
POOL=leo-spaces
MODPROBE_CONF=/etc/modprobe.d/leo-spaces-vfio.conf
# Sorts last among the drop-ins (mkinitcpio concatenates them after the main
# file, version-sorted) and APPENDS, so a distribution drop-in that assigns
# MODULES= cannot take vfio out of the image.
MKINITCPIO_DROPIN=/etc/mkinitcpio.conf.d/zz-leo-spaces-vfio.conf
# A mirror that stops sending must become a failure, not a `.part` that sits
# at the same size forever under a curl nothing will ever reap: under 10 KB/s
# for a minute is the end of that attempt (and --retry gets the next one).
CURL_PATIENCE="--connect-timeout 20 --speed-limit 10240 --speed-time 60"
VIRTIO_URL=https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/stable-virtio/virtio-win.iso

die() { printf 'leo-spaces-admin: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*"; }

[ "$(id -u)" = "0" ] || die "must run as root (it is meant to be reached through its sudoers rule)"

# ── Which package manager, and the list for it ────────────────────────────────
#
# Duplicated from src/provision.rs on purpose. The wrapper has to work when
# run by hand on a box with no hub — that is its recovery story — so it cannot
# take the list as an argument without also accepting an argument that installs
# anything at all.
detect_pm() {
  if command -v pacman  >/dev/null 2>&1; then echo pacman
  elif command -v apt-get >/dev/null 2>&1; then echo apt
  elif command -v dnf    >/dev/null 2>&1; then echo dnf
  else echo unknown; fi
}

v_install_packages() {
  case "$(detect_pm)" in
    pacman)
      pacman -S --needed --noconfirm \
        qemu-full libvirt virt-install edk2-ovmf swtpm dnsmasq dmidecode
      ;;
    apt)
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -qq
      apt-get install -y \
        qemu-system-x86 qemu-utils libvirt-daemon-system libvirt-clients \
        virtinst ovmf swtpm swtpm-tools dnsmasq-base dmidecode
      ;;
    dnf)
      dnf install -y \
        qemu-kvm libvirt virt-install edk2-ovmf swtpm swtpm-tools dnsmasq dmidecode
      ;;
    *) die "no supported package manager found" ;;
  esac
  say "packages installed"
}

# ── The daemon ────────────────────────────────────────────────────────────────
#
# Arch ships the monolithic libvirtd; Debian has moved to the modular daemons.
# Try the monolithic socket first and fall back, because a host with either is
# a working host and a script that knew only one would report a fine box broken.
v_enable_daemon() {
  local started=0
  if systemctl list-unit-files libvirtd.socket >/dev/null 2>&1 \
     && systemctl enable --now libvirtd.socket 2>/dev/null; then
    started=1
  elif systemctl enable --now virtqemud.socket virtnetworkd.socket virtstoraged.socket 2>/dev/null; then
    started=1
  fi
  [ "$started" = "1" ] || die "could not enable libvirt — is it installed?"
  # virtlogd captures guest serial output. Without it a guest that fails to
  # boot does so with nothing written down anywhere.
  systemctl enable --now virtlogd.socket 2>/dev/null || true
  say "libvirt enabled"
}

virsh_sys() { virsh --connect qemu:///system "$@"; }

# ── Guest networking ──────────────────────────────────────────────────────────
v_setup_network() {
  if ! virsh_sys net-info default >/dev/null 2>&1; then
    local xml=""
    for cand in /usr/share/libvirt/networks/default.xml \
                /usr/share/doc/libvirt/examples/network/default.xml; do
      [ -f "$cand" ] && xml="$cand" && break
    done
    if [ -n "$xml" ]; then
      virsh_sys net-define "$xml"
    else
      # Some packagings ship no example. Define the same network by hand
      # rather than leaving the host without one.
      local tmp
      tmp=$(mktemp)
      cat > "$tmp" <<'XML'
<network>
  <name>default</name>
  <forward mode='nat'/>
  <bridge name='virbr0' stp='on' delay='0'/>
  <ip address='192.168.122.1' netmask='255.255.255.0'>
    <dhcp><range start='192.168.122.2' end='192.168.122.254'/></dhcp>
  </ip>
</network>
XML
      virsh_sys net-define "$tmp"
      rm -f "$tmp"
    fi
  fi
  virsh_sys net-autostart default >/dev/null
  virsh_sys net-start default >/dev/null 2>&1 || true
  virsh_sys net-info default | grep -qi '^Active:.*yes' \
    || die "the default network is defined but will not start — check 'journalctl -u libvirtd'"
  say "default network active"
}

# ── Storage ───────────────────────────────────────────────────────────────────
v_setup_storage() {
  mkdir -p "$STATE_DIR"/disks "$STATE_DIR"/iso "$STATE_DIR"/nvram
  # qemu runs guests as its own user and has to write disks and firmware vars.
  local qu=qemu
  id -u qemu >/dev/null 2>&1 || qu=libvirt-qemu
  if id -u "$qu" >/dev/null 2>&1; then
    chown -R "$qu":"$qu" "$STATE_DIR"/disks "$STATE_DIR"/nvram
  fi
  chmod 0751 "$STATE_DIR"
  if ! virsh_sys pool-info "$POOL" >/dev/null 2>&1; then
    virsh_sys pool-define-as "$POOL" dir --target "$STATE_DIR/disks" >/dev/null
  fi
  virsh_sys pool-autostart "$POOL" >/dev/null
  virsh_sys pool-start "$POOL" >/dev/null 2>&1 || true
  say "storage pool $POOL ready at $STATE_DIR/disks"
}

# ── Group membership ──────────────────────────────────────────────────────────
#
# $SUDO_USER is the account that invoked us. Validated against the passwd
# database rather than trusted: it arrives from the environment, and `usermod`
# would take any string.
v_add_group() {
  local u="${SUDO_USER:-}"
  [ -n "$u" ] || u=$(logname 2>/dev/null || true)
  [ -n "$u" ] || die "cannot tell which account to add — run through sudo"
  id -u "$u" >/dev/null 2>&1 || die "no such account: $u"
  getent group libvirt >/dev/null || die "there is no libvirt group — install the packages first"
  usermod -aG libvirt "$u"
  say "added $u to libvirt (group membership is read at login — restart the hub service)"
}

# ── Windows virtio drivers ────────────────────────────────────────────────────
# The primary volume descriptor is sector 16: a type byte at offset 32768,
# then "CD001" at 32769..32773 — so the first 32774 bytes end on it.
looks_like_iso() {
  head -c 32774 "$1" 2>/dev/null | tail -c 5 | grep -q CD001
}

# The installers this helper may fetch, and from where. One line per OS:
#   id|file|url|<address>            a name the distribution keeps current
#   id|file|dir|<directory>|<pattern> a listing to read and the file to pick
# This is the ONLY source of addresses root downloads from — the app names an
# id, never a URL. It is the same table as src/catalog.rs, and the package's
# tests hold the two equal (the_helpers_catalog_is_this_one).
ISO_CATALOG='
win2k25|win2k25.iso|url|https://go.microsoft.com/fwlink/?linkid=2293312
win2k22|win2k22.iso|url|https://go.microsoft.com/fwlink/p/?linkid=2195280
win2k19|win2k19.iso|url|https://go.microsoft.com/fwlink/p/?linkid=2195167
ubuntu24.04|ubuntu-24.04-live-server-amd64.iso|dir|https://releases.ubuntu.com/24.04/|ubuntu-24\.04(\.[0-9]+)?-live-server-amd64\.iso
ubuntu26.04|ubuntu-26.04-live-server-amd64.iso|dir|https://releases.ubuntu.com/26.04/|ubuntu-26\.04(\.[0-9]+)?-live-server-amd64\.iso
debian13|debian-13-amd64-netinst.iso|dir|https://cdimage.debian.org/debian-cd/current/amd64/iso-cd/|debian-13[0-9.]*-amd64-netinst\.iso
fedora43|fedora-server-43-x86_64.iso|dir|https://download.fedoraproject.org/pub/fedora/linux/releases/43/Server/x86_64/iso/|Fedora-Server-dvd-x86_64-43-[0-9.]+\.iso
archlinux|archlinux-x86_64.iso|url|https://geo.mirror.pkgbuild.com/iso/latest/archlinux-x86_64.iso
rocky10|rocky-10-x86_64-minimal.iso|url|https://download.rockylinux.org/pub/rocky/10/isos/x86_64/Rocky-10-latest-x86_64-minimal.iso
rocky9|rocky-9-x86_64-minimal.iso|url|https://download.rockylinux.org/pub/rocky/9/isos/x86_64/Rocky-9-latest-x86_64-minimal.iso
almalinux10|almalinux-10-x86_64-minimal.iso|url|https://repo.almalinux.org/almalinux/10/isos/x86_64/AlmaLinux-10-latest-x86_64-minimal.iso
opensuse16.0|opensuse-leap-16.0-x86_64.iso|dir|https://download.opensuse.org/distribution/leap/16.0/iso/|[A-Za-z-]*Leap-16\.0[^"<> ]*x86_64[^"<> ]*\.iso
opensusetumbleweed|opensuse-tumbleweed-x86_64.iso|url|https://download.opensuse.org/tumbleweed/iso/openSUSE-Tumbleweed-DVD-x86_64-Current.iso
freebsd15.0|freebsd-15.0-amd64-disc1.iso|url|https://download.freebsd.org/releases/amd64/amd64/ISO-IMAGES/15.0/FreeBSD-15.0-RELEASE-amd64-disc1.iso
freebsd14.3|freebsd-14.3-amd64-disc1.iso|url|https://download.freebsd.org/releases/amd64/amd64/ISO-IMAGES/14.3/FreeBSD-14.3-RELEASE-amd64-disc1.iso
'

# Start fetching one installer from the catalog, detached. Returns at once:
# a multi-gigabyte download must not live inside a request, and the first
# virtio fetch died exactly that way. Progress is the `.part` beside the
# destination, failure is the `.log` left there — the app reads both.
v_fetch_iso() {
  local id="${1:-}"
  [ -n "$id" ] || die "fetch-iso needs an OS id from the catalog"
  case "$id" in *[!a-z0-9.]*) die "not a catalog id: $id" ;; esac
  local line
  line=$(printf '%s\n' "$ISO_CATALOG" | awk -F'|' -v id="$id" '$1==id {print; exit}')
  [ -n "$line" ] || die "$id is not an installer this helper can fetch — client Windows images are brought by hand"
  local file kind a b
  IFS='|' read -r _ file kind a b <<<"$line"
  mkdir -p "$STATE_DIR/iso"
  local dest="$STATE_DIR/iso/$file"
  if [ -s "$dest" ]; then
    say "$file is already on the host"
    return
  fi
  if [ -e "$dest.part" ]; then
    if pgrep -f -- "-o $dest.part" >/dev/null 2>&1; then
      die "$file is already downloading"
    fi
    # Left by a download whose process is gone — a reboot, a kill. Start over.
    rm -f "$dest.part"
  fi
  command -v curl >/dev/null 2>&1 || die "curl is not installed"

  local url
  if [ "$kind" = url ]; then
    url="$a"
  else
    local name
    name=$(curl -fsSL "$a" | grep -oE "$b" | sort -uV | tail -1) || true
    [ -n "$name" ] || die "nothing at $a matches the catalog's pattern for $id — its address may be stale; put the image at $dest by hand"
    url="${a}${name}"
  fi
  rm -f "$dest.log"
  # setsid + nohup: a new session that ignores the hangup the sudo'd ssh
  # sends when the caller's request ends. The log is removed on success so
  # its presence means exactly one thing.
  nohup setsid bash -c '
    dest="$1"; url="$2"; patience="$3"
    if curl -fsSL --retry 3 $patience -o "$dest.part" "$url" \
       && head -c 32774 "$dest.part" | tail -c 5 | grep -q CD001; then
      mv "$dest.part" "$dest" && rm -f "$dest.log"
    else
      echo "download of $url failed, or what came back is not an ISO 9660 image"
      rm -f "$dest.part"
    fi
  ' _ "$dest" "$url" "$CURL_PATIENCE" >"$dest.log" 2>&1 </dev/null &
  say "downloading $file from $url — the Installers panel shows progress"
}

# Where an installer the package fetched AS LEO waits to be adopted. Root
# never takes an address from a request; it takes a file from here, by
# catalog id, after checking it is an ISO. This is how a licensed image —
# downloaded in a browser, copied from a Mac — reaches the root-owned media
# directory without a root shell.
IMPORT_DIR=/var/lib/leo/spaces-import

# Adopt a staged installer: /var/lib/leo/spaces-import/<id>.iso becomes the
# catalog's file for <id> under the media directory, root-owned. The catalog
# itself is not consulted for the name: client Windows is not in
# ISO_CATALOG (no address), so the destination is <id>.iso for those and the
# catalog's file name for the rest.
v_import_iso() {
  local id="${1:-}"
  [ -n "$id" ] || die "import-iso needs an OS id"
  case "$id" in *[!a-z0-9.]*) die "not a catalog id: $id" ;; esac
  local src="$IMPORT_DIR/$id.iso"
  [ -f "$src" ] || die "nothing staged at $src"
  [ -L "$src" ] && die "$src is a symlink — refusing"
  # The staged file must be a plain file leo put there, not a device or a
  # hardlink into something root owns.
  [ "$(stat -c %U "$src")" = "leo" ] || die "$src is not leo's"
  looks_like_iso "$src" || die "$src is not an ISO 9660 image"
  local file
  file=$(printf '%s\n' "$ISO_CATALOG" | awk -F'|' -v id="$id" '$1==id {print $2; exit}')
  [ -n "$file" ] || file="$id.iso"
  mkdir -p "$STATE_DIR/iso"
  local dest="$STATE_DIR/iso/$file"
  [ -e "$dest" ] && die "$file is already on the host"
  # Same filesystem or not, end up with a root-owned copy and nothing left
  # in the staging dir.
  mv "$src" "$dest" 2>/dev/null || { cp "$src" "$dest" && rm -f "$src"; }
  chown root:root "$dest"; chmod 0644 "$dest"
  say "$file imported"
}

# The "Leo guest tools" CD a space is created with: the Leo satellite for
# the guest's platform, its installer, and two text files naming the hub it
# should pair with and the space's own name. Built per space (the name is in
# it) from a staging directory leo fills — root takes files, never addresses —
# into the root-owned media directory, as the other images are.
#
#   /var/lib/leo/spaces-import/guest-tools/<space>/   (leo writes)
#     leo-satellited.exe, install-leo-satellite.ps1, leo-hub.txt, leo-name.txt
#   /var/lib/leo-spaces/iso/guest-tools-<space>.iso   (root writes)
v_build_guest_tools() {
  local name="${1:-}"
  [ -n "$name" ] || die "build-guest-tools needs a space name"
  case "$name" in *[!a-zA-Z0-9_-]*) die "not a space name: $name" ;; esac
  local src="$IMPORT_DIR/guest-tools/$name"
  [ -d "$src" ] || die "nothing staged at $src"
  [ "$(stat -c %U "$src")" = "leo" ] || die "$src is not leo's"
  [ -f "$src/install-leo-satellite.ps1" ] || die "$src has no installer"
  command -v xorrisofs >/dev/null 2>&1 || die "xorrisofs is not installed (package: libisoburn)"
  mkdir -p "$STATE_DIR/iso"
  local dest="$STATE_DIR/iso/guest-tools-$name.iso"
  # Joliet + Rock Ridge so the names survive on Windows and on Linux guests
  # alike; `-no-pad` keeps a 20 MB image 20 MB.
  xorrisofs -quiet -J -R -V "LEO_GUEST_TOOLS" -o "$dest.part" "$src" || die "building $dest failed"
  mv "$dest.part" "$dest"
  # The CD can carry the guest's admin password and a satellite token, so it
  # is readable by the emulator's account and nobody else — unlike the public
  # installer images beside it.
  local qg=libvirt-qemu
  getent group "$qg" >/dev/null 2>&1 || qg=kvm
  chown "root:$qg" "$dest"; chmod 0640 "$dest"
  say "$dest built"
}

# Let guests on libvirt's `default` network get an address and reach out.
#
# Leo OS runs a firewall (`table inet leo-firewall` in /etc/nftables.conf)
# whose input and forward chains both end in drop, and neither knows
# virbr0: a guest's DHCP broadcast dies on input before dnsmasq hears it
# ("Unidentified network"), and a guest with an address still cannot
# forward out. libvirt adds its own table, but an accept there cannot undo a
# drop here — nft drops a packet if any base chain on the hook drops it —
# so the rules have to go INTO leo-firewall's chains, ahead of its drop.
#
# Hence `insert rule` (prepend), tagged with a comment so a re-run deletes
# its own rules first and is idempotent, kept in /etc/nftables.d/ like the
# VPN package's masquerade, and re-applied by a unit that is PartOf
# nftables.service — that unit opens with `flush ruleset`, which takes
# these rules with it on every firewall restart.
GUEST_NET_CONF=/etc/nftables.d/leo-spaces-guests.conf
GUEST_NET_UNIT=/etc/systemd/system/leo-spaces-guest-net.service
GUEST_BRIDGE=virbr0
GUEST_SUBNET=192.168.122.0/24

v_open_guest_network() {
  command -v nft >/dev/null 2>&1 || die "nft is not installed"
  mkdir -p /etc/nftables.d
  cat > "$GUEST_NET_CONF" <<EOF
#!/usr/sbin/nft -f
# Written by leo-spaces-admin. Guests on $GUEST_BRIDGE: DHCP and DNS from the
# host, and forwarding out. Inserted ahead of leo-firewall's drops, and tagged
# so open-guest-network can replace them. Not a table of its own: an accept
# in another table cannot override a drop in this one.
insert rule inet leo-firewall input iifname "$GUEST_BRIDGE" udp dport { 67, 53 } accept comment "leo-spaces guests"
insert rule inet leo-firewall input iifname "$GUEST_BRIDGE" tcp dport { 53, 8420 } accept comment "leo-spaces guests"
insert rule inet leo-firewall forward iifname "$GUEST_BRIDGE" ip saddr $GUEST_SUBNET accept comment "leo-spaces guests"
insert rule inet leo-firewall forward oifname "$GUEST_BRIDGE" ct state established,related accept comment "leo-spaces guests"
EOF
  cat > "$GUEST_NET_UNIT" <<EOF
[Unit]
Description=Leo Spaces — open the guest network in the host firewall
After=network-online.target nftables.service libvirtd.service
Wants=network-online.target
PartOf=nftables.service
ConditionPathExists=$GUEST_NET_CONF

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/leo-spaces-admin apply-guest-network

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  # The unit does the applying, now and at every boot — `restart` so a
  # re-run re-inserts the rules through the same path the boot uses, and
  # the probe (file + active unit) agrees with what is in force.
  systemctl enable leo-spaces-guest-net.service >/dev/null 2>&1 || true
  systemctl restart leo-spaces-guest-net.service || die "leo-spaces-guest-net.service failed — journalctl -u leo-spaces-guest-net"
  say "guest network open: DHCP/DNS to the host and forwarding out, for $GUEST_SUBNET on $GUEST_BRIDGE"
}

# The live half, also what the unit runs at boot. Removes this script's own
# rules (by their comment) and inserts them afresh, so it is safe to run as
# often as anyone likes. With no leo-firewall table there is nothing to open.
apply_guest_network() {
  if ! nft list table inet leo-firewall >/dev/null 2>&1; then
    say "no leo-firewall table is loaded — nothing drops guest traffic here"
    return 0
  fi
  local chain handle
  for chain in input forward; do
    for handle in $(nft -a list chain inet leo-firewall "$chain" 2>/dev/null | grep 'comment "leo-spaces guests"' | sed -n 's/.*# handle \([0-9]*\).*/\1/p'); do
      nft delete rule inet leo-firewall "$chain" handle "$handle"
    done
  done
  nft -f "$GUEST_NET_CONF"
}

v_fetch_virtio() {
  mkdir -p "$STATE_DIR/iso"
  local dest="$STATE_DIR/iso/virtio-win.iso"
  # One download at a time: a second Apply while the first is still pulling
  # would reopen the same .part with O_TRUNC underneath it.
  exec 9>"$STATE_DIR/iso/.fetch.lock"
  flock -n 9 || die "a virtio-win download is already running"
  if [ -s "$dest" ]; then
    say "virtio-win.iso already present"
    return
  fi
  command -v curl >/dev/null 2>&1 || die "curl is not installed"
  curl -fsSL --retry 3 $CURL_PATIENCE -o "$dest.part" "$VIRTIO_URL"
  # An ISO that is actually an error page is worse than no ISO: Windows setup
  # mounts it, finds no drivers, and the failure looks like broken storage.
  if ! looks_like_iso "$dest.part"; then
    rm -f "$dest.part"
    die "what came back is not an ISO 9660 image — check the network entitlement"
  fi
  mv "$dest.part" "$dest"
  say "virtio-win.iso downloaded to $dest"
}

# ── The kernel command line ───────────────────────────────────────────────────
#
# The one genuinely dangerous thing here, so: a backup first, every time, into
# a timestamped directory; and the fallback/recovery entries are left alone, so
# whatever else happens there is still an entry that boots the way it did
# before. systemd-boot also lets you edit the command line at the menu with
# 'e', which is the other way back.
backup_dir() {
  local d="$STATE_DIR/boot-backup-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$d"
  echo "$d"
}

iommu_params() {
  if grep -qm1 AuthenticAMD /proc/cpuinfo; then echo "amd_iommu=on iommu=pt"
  elif grep -qm1 GenuineIntel /proc/cpuinfo; then echo "intel_iommu=on iommu=pt"
  else echo "iommu=pt"; fi
}

v_enable_iommu() {
  local params; params=$(iommu_params)
  local bk; bk=$(backup_dir)

  if [ -d /boot/loader/entries ] && command -v bootctl >/dev/null 2>&1; then
    local touched=0
    shopt -s nullglob
    for entry in /boot/loader/entries/*.conf; do
      case "$(basename "$entry")" in
        *fallback*|*recovery*|*rescue*)
          say "left $(basename "$entry") alone as a way back"
          continue ;;
      esac
      grep -q '^options' "$entry" || continue
      cp -a "$entry" "$bk/"
      local missing=""
      for p in $params; do
        grep -q -- "$p" "$entry" || missing="${missing:+$missing }$p"
      done
      if [ -n "$missing" ]; then
        # Append to the existing options line rather than adding a second one:
        # systemd-boot reads only the first, so a second is a silent no-op.
        sed -i "0,/^options/{s|^options\(.*\)$|options\1 $missing|}" "$entry"
        touched=1
        say "added '$missing' to $(basename "$entry")"
      else
        say "$(basename "$entry") already has the parameters"
      fi
    done
    shopt -u nullglob
    say "backup in $bk"
    [ "$touched" = "1" ] && say "REBOOT REQUIRED" || true
    return
  fi

  if [ -f /etc/default/grub ]; then
    cp -a /etc/default/grub "$bk/"
    local missing=""
    for p in $params; do
      grep -q -- "$p" /etc/default/grub || missing="${missing:+$missing }$p"
    done
    if [ -z "$missing" ]; then
      say "/etc/default/grub already has the parameters"
      return
    fi
    if grep -q '^GRUB_CMDLINE_LINUX_DEFAULT=' /etc/default/grub; then
      sed -i "s|^GRUB_CMDLINE_LINUX_DEFAULT=\"\(.*\)\"|GRUB_CMDLINE_LINUX_DEFAULT=\"\1 $missing\"|" /etc/default/grub
    else
      echo "GRUB_CMDLINE_LINUX_DEFAULT=\"$missing\"" >> /etc/default/grub
    fi
    local cfg=/boot/grub/grub.cfg
    [ -d /boot/grub2 ] && cfg=/boot/grub2/grub.cfg
    if command -v grub-mkconfig >/dev/null 2>&1; then grub-mkconfig -o "$cfg"
    elif command -v grub2-mkconfig >/dev/null 2>&1; then grub2-mkconfig -o "$cfg"
    else die "grub config edited but no grub-mkconfig to apply it — regenerate by hand"; fi
    say "backup in $bk"
    say "REBOOT REQUIRED"
    return
  fi

  die "no systemd-boot entries and no /etc/default/grub — add '$params' however this box sets its kernel command line"
}

# ── VFIO binding ──────────────────────────────────────────────────────────────
#
# The only verb taking an argument. `vendor:device`, four hex digits each, and
# nothing else gets past the pattern — the value is written into a modprobe
# config that root reads back as instructions.
valid_ids() {
  [[ "$1" =~ ^[0-9a-fA-F]{4}:[0-9a-fA-F]{4}(,[0-9a-fA-F]{4}:[0-9a-fA-F]{4})*$ ]]
}

v_bind_vfio() {
  local new="${1:-}"
  [ -n "$new" ] || die "bind-vfio needs a vendor:device pair, e.g. 10de:24b0"
  valid_ids "$new" || die "not a vendor:device pair: $new"

  # Accumulate rather than replace: a second card must not silently unbind the
  # first, which is what a plain overwrite would do on the next reboot.
  local existing=""
  if [ -f "$MODPROBE_CONF" ]; then
    existing=$(sed -n 's/^options vfio-pci ids=\([^ ]*\).*/\1/p' "$MODPROBE_CONF" | head -1)
  fi
  local all="$new"
  if [ -n "$existing" ]; then
    all="$existing"
    local one
    for one in ${new//,/ }; do
      case ",$all," in
        *",$one,"*) ;;
        *) all="$all,$one" ;;
      esac
    done
  fi
  valid_ids "$all" || die "refusing to write a malformed id list: $all"

  cat > "$MODPROBE_CONF" <<EOF
# Written by leo-spaces-admin. Devices listed here are claimed by vfio-pci at
# boot instead of their normal driver, so a guest can own them outright.
options vfio-pci ids=$all
# And claimed FIRST: whichever display or audio driver would otherwise take
# one of them is made to wait for vfio-pci, so the id list above decides.
softdep nvidia pre: vfio-pci
softdep nouveau pre: vfio-pci
softdep amdgpu pre: vfio-pci
softdep radeon pre: vfio-pci
softdep i915 pre: vfio-pci
softdep xe pre: vfio-pci
softdep ast pre: vfio-pci
softdep snd_hda_intel pre: vfio-pci
EOF
  say "vfio-pci will claim: $all"

  # The modules have to be in the initramfs, or the real driver binds first
  # and vfio-pci finds the device already taken.
  local marker
  marker=$(mktemp)
  if [ -f /etc/mkinitcpio.conf ]; then
    cp -a /etc/mkinitcpio.conf "$(backup_dir)/"
    local mods="vfio_pci vfio vfio_iommu_type1"
    local need=""
    for m in $mods; do
      grep -qE "^MODULES=.*\b$m\b" /etc/mkinitcpio.conf || need="${need:+$need }$m"
    done
    if [ -n "$need" ]; then
      # Insert into the MODULES=() array, preserving whatever is already there.
      sed -i "s|^MODULES=(\(.*\))|MODULES=(\1 $need)|" /etc/mkinitcpio.conf
      sed -i 's|^MODULES=( |MODULES=(|' /etc/mkinitcpio.conf
    fi
    # The edit above is not enough on its own: /etc/mkinitcpio.conf.d/*.conf
    # is concatenated AFTER the main file, and a distribution's own drop-in
    # saying `MODULES=(amdgpu)` replaced the list wholesale — which is how an
    # image was built with no vfio in it while this verb said REBOOT REQUIRED.
    mkdir -p "$(dirname "$MKINITCPIO_DROPIN")"
    cat > "$MKINITCPIO_DROPIN" <<EOF
# Written by leo-spaces-admin. Appends, so a drop-in that assigns MODULES=
# cannot drop these; named to sort last, so nothing assigns after it.
MODULES+=(vfio_pci vfio vfio_iommu_type1)
EOF
    command -v mkinitcpio >/dev/null 2>&1 || die "mkinitcpio not found"
    mkinitcpio -P
    verify_initramfs_has_vfio "$marker"
  elif [ -d /etc/initramfs-tools ]; then
    for m in vfio_pci vfio vfio_iommu_type1; do
      grep -qx "$m" /etc/initramfs-tools/modules 2>/dev/null \
        || echo "$m" >> /etc/initramfs-tools/modules
    done
    command -v update-initramfs >/dev/null 2>&1 && update-initramfs -u \
      || die "update-initramfs not found"
  elif command -v dracut >/dev/null 2>&1; then
    echo 'add_drivers+=" vfio_pci vfio vfio_iommu_type1 "' \
      > /etc/dracut.conf.d/leo-spaces-vfio.conf
    dracut --force
  else
    die "modprobe config written, but no initramfs generator found — rebuild it by hand"
  fi
  # Bind now, not just at next boot, wherever that is safe: a function whose
  # driver is not the console's (the card's audio, a card nothing displays
  # on) can be handed to vfio-pci live, and the guest can start without a
  # reboot. The host's own display is left to the reboot — unbinding it
  # live blanks the console.
  modprobe vfio-pci 2>/dev/null || true
  local pending=0 dev addr vd cur
  for dev in /sys/bus/pci/devices/*; do
    vd="$(sed s/^0x// "$dev/vendor" 2>/dev/null):$(sed s/^0x// "$dev/device" 2>/dev/null)"
    case ",$all," in *",$vd,"*) ;; *) continue ;; esac
    addr=$(basename "$dev")
    cur=$(basename "$(readlink -f "$dev/driver" 2>/dev/null)" 2>/dev/null)
    [ "$cur" = "vfio-pci" ] && continue
    if [ "$(cat "$dev/boot_vga" 2>/dev/null)" = "1" ]; then
      say "$addr is the host's display — it moves to vfio-pci at the next boot"
      pending=1; continue
    fi
    echo vfio-pci > "$dev/driver_override" 2>/dev/null || true
    [ -n "$cur" ] && echo "$addr" > "/sys/bus/pci/drivers/$cur/unbind" 2>/dev/null
    echo "$addr" > /sys/bus/pci/drivers_probe 2>/dev/null
    if [ "$(basename "$(readlink -f "$dev/driver" 2>/dev/null)" 2>/dev/null)" = "vfio-pci" ]; then
      say "$addr ($vd) bound to vfio-pci now"
    else
      say "$addr ($vd) could not be rebound live — it moves at the next boot"
      pending=1
    fi
  done
  if [ "$pending" = 1 ]; then say "REBOOT REQUIRED"; else say "bound — no reboot needed"; fi
}

# The image mkinitcpio just wrote has to actually carry vfio_pci and the id
# list, or the reboot this verb asks for changes nothing. Checked rather than
# assumed, because the first time it was assumed it was wrong.
verify_initramfs_has_vfio() {
  local marker="$1" img found=0
  if ! command -v lsinitcpio >/dev/null 2>&1; then
    rm -f "$marker"
    say "lsinitcpio not found — the rebuilt image was not checked"
    return
  fi
  while IFS= read -r img; do
    found=1
    if ! lsinitcpio "$img" 2>/dev/null | grep -qE '(^|/)vfio[-_]pci\.ko'; then
      rm -f "$marker"
      die "$img was rebuilt but carries no vfio_pci module — something in /etc/mkinitcpio.conf.d assigns MODULES= after $MKINITCPIO_DROPIN"
    fi
    if ! lsinitcpio "$img" 2>/dev/null | grep -q "etc/modprobe.d/$(basename "$MODPROBE_CONF")"; then
      rm -f "$marker"
      die "$img carries vfio_pci but not $MODPROBE_CONF — the modconf hook is missing from HOOKS"
    fi
    say "$img carries vfio_pci and the id list"
  done < <(find /boot /efi -maxdepth 3 -name 'initramfs-*.img' -newer "$marker" 2>/dev/null)
  rm -f "$marker"
  [ "$found" = 1 ] || die "mkinitcpio -P wrote no initramfs under /boot or /efi"
}

v_unbind_vfio() {
  rm -f "$MODPROBE_CONF" "$MKINITCPIO_DROPIN" /etc/dracut.conf.d/leo-spaces-vfio.conf
  if [ -f /etc/mkinitcpio.conf ] && command -v mkinitcpio >/dev/null 2>&1; then
    mkinitcpio -P
  elif [ -d /etc/initramfs-tools ] && command -v update-initramfs >/dev/null 2>&1; then
    update-initramfs -u
  elif command -v dracut >/dev/null 2>&1; then
    dracut --force
  fi
  say "vfio-pci binding removed — REBOOT REQUIRED"
}

# ── Dispatch ──────────────────────────────────────────────────────────────────
#
# The closed set. Anything not named here exits non-zero without running
# anything, which is what makes one sudoers rule naming this file a narrow
# grant rather than a root shell.
case "${1:-}" in
  version)          say "leo-spaces-admin $VERSION" ;;
  install-packages) v_install_packages ;;
  enable-daemon)    v_enable_daemon ;;
  setup-network)    v_setup_network ;;
  setup-storage)    v_setup_storage ;;
  add-group)        v_add_group ;;
  fetch-virtio)     v_fetch_virtio ;;
  enable-iommu)     v_enable_iommu ;;
  bind-vfio)        v_bind_vfio "${2:-}" ;;
  unbind-vfio)      v_unbind_vfio ;;
  fetch-iso)        v_fetch_iso "${2:-}" ;;
  import-iso)       v_import_iso "${2:-}" ;;
  build-guest-tools) v_build_guest_tools "${2:-}" ;;
  open-guest-network) v_open_guest_network ;;
  apply-guest-network) apply_guest_network ;;
  *)
    die "unknown verb '${1:-}'. Known: version install-packages enable-daemon setup-network setup-storage add-group fetch-virtio enable-iommu bind-vfio unbind-vfio fetch-iso import-iso build-guest-tools open-guest-network"
    ;;
esac
